# ==============================================================================
# DataFlow - Real-Time Distributed Data Pipeline & Analytics Platform
# Environment Configuration Template (.env.example)
# Copy this file to .env and customize for your local / cloud environment
# ==============================================================================

# Application Profile (local, dev, prod)
APP_ENV=local
SERVER_PORT=8080

# PostgreSQL (Application Metadata, Pipeline States & pgvector AI Retrieval)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dataflow_db
POSTGRES_USER=dataflow_user
POSTGRES_PASSWORD=dataflow_secure_password_123

# MinIO (S3-Compatible Local Data Lake)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=dataflow-lake
MINIO_REGION=us-east-1

# Apache Kafka (Real-time Event Streaming)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REVIEWS=dataflow.restaurant.reviews
KAFKA_TOPIC_RESTAURANTS=dataflow.restaurant.events
KAFKA_TOPIC_DLQ=dataflow.restaurant.dlq
KAFKA_CONSUMER_GROUP=dataflow-analytics-group

# Apache Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=DataFlow-Spark-ETL

# Snowflake Data Warehouse (Cloud Analytics Layer)
# Note: For Phase 0 to Phase 4 local runs, Snowflake is optional (PostgreSQL/DuckDB local fallbacks supported)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=dataflow_svc
SNOWFLAKE_PASSWORD=snowflake_secret_pass
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ZOMATO_DWH
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=DATAFLOW_ROLE

# AI & LLM Service (Local Ollama or OpenAI / Cloud endpoint)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=your_openai_api_key_here_if_using_openai

# Redis (Optional Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Monitoring & Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
